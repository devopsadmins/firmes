---
import '../styles/global.css';
interface Props { titulo: string; descricao?: string; secao?: string; imagem?: string }
const { titulo, descricao = 'Devocional diário, lições de Escola Dominical e roteiros de encontro para homens cristãos.', secao = '', imagem = '/img/og.jpg' } = Astro.props;
const menu = [
  { href: '/devocional/', nome: 'Devocional', id: 'devocional' },
  { href: '/escola-dominical/', nome: 'Escola Dominical', id: 'ebd' },
  { href: '/grupos/', nome: 'Grupos de homens', id: 'grupos' },
  { href: '/livros/', nome: 'Livros', id: 'livros' },
];
const tituloPagina = titulo === 'Firmes' ? 'Firmes · estudo para homens cristãos' : `${titulo} · Firmes`;
const og = new URL(imagem, Astro.site).toString();
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{tituloPagina}</title>
  <meta name="description" content={descricao} />
  <meta property="og:title" content={tituloPagina} />
  <meta property="og:description" content={descricao} />
  <meta property="og:image" content={og} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#0f1d3a" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Figtree:wght@400;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" />
</head>
<body>
  <header class="topo">
    <div class="container">
      <a class="marca" href="/">Fir<span>mes</span></a>
      <nav class="menu" aria-label="Seções">
        {menu.map((m) => <a href={m.href} aria-current={secao === m.id ? 'page' : undefined}>{m.nome}</a>)}
      </nav>
    </div>
  </header>
  <main><div class="container"><slot /></div></main>
  <footer class="rodape">
    <div class="container">
      <p><b>Firmes</b> é um espaço de estudo para homens do <a href="https://igrejareformada.app">igrejareformada.app</a>. O nome vem de 1 Coríntios 16.13: “permanecei firmes na fé”.</p>
      <p>Os textos são autorais e de uso livre em igrejas, na Escola Dominical e em grupos de homens. Os livros indicados são de seus autores e editoras, e o site não reproduz o texto deles. Versículos na Almeida Revista e Atualizada (ARA).</p>
    </div>
  </footer>
</body>
</html>
